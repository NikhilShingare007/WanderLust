<style>
  .navbar {
    position: relative;
  }

  .navbar .container-fluid {
    flex-wrap: nowrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .nav-logo {
    margin-right: 1rem;
  }

  .navbar-center {
    flex: 1;
    display: flex;
    justify-content: center;
    padding: 0 4rem;
  }

  .search-form {
    width: 100%;
    max-width: 600px;
    display: flex;
  }

  .search-input {
    flex-grow: 1;
    min-width: 0;
    padding: 0.7rem 1rem;
    border-radius: 25px;
    font-size: 1rem;
  }

  .btn-search {
    border-color: #fa424d !important;
    border-radius: 25px;
    padding: 0.5rem 1rem;
    white-space: nowrap;
  }

  .btn-search:hover {
    background-color: #fa424d !important;
    color: white;
    border: none;
  }

  .navbar-collapse {
    flex-shrink: 0;
  }

  .navbar-nav {
    display: flex;
    gap: 1rem;
  }

  .navbar-nav .nav-link {
    padding: 0.5rem 1rem;
  }

  /* Mobile Responsive */
  @media (max-width: 430px) {
    .navbar-center {
      padding: 0 1rem;
      margin-top: 0.5rem;
      width: 100%;
    }

    .search-form {
      width: 100%;
    }

    .search-input {
      font-size: 0.85rem;
      padding: 0.5rem 0.8rem;
    }

    .btn-search {
      padding: 0.4rem 0.8rem;
      font-size: 0.85rem;
    }

    .nav-logo {
      display: none !important;
    }

    .navbar-collapse {
      background-color: white;
      padding: 1rem;
    }

    .navbar-nav {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .navbar-nav .nav-link {
      padding-left: 0.5rem;
      width: 100%;
    }
  }

  @media (max-width: 820px) {
    .navbar-center {
      padding: 0 1rem;
      margin-top: 0.5rem;
    }

    .search-form {
      width: 100%;
    }

    .search-input {
      font-size: 0.9rem;
      padding: 0.6rem 0.8rem;
    }
  }
</style>

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid position-relative">
    <!-- Logo on the left -->
    <a class="navbar-brand nav-logo me-2" href="/listings">
      <i class="fa-brands fa-slack text-danger fs-3"></i>
    </a>

    <!-- Search bar in center -->
    <div class="navbar-center">
      <form
        class="search-form align-items-center"
        method="GET"
        action="/listings/search"
      >
        <input
          name="search"
          class="form-control me-2 search-input"
          type="search"
          placeholder="Search Destination"
        />
        <button
          class="btn btn-outline-danger btn-search d-flex align-items-center"
          type="submit"
        >
          <i class="fa-brands fa-searchengin me-1"></i> Search
        </button>
      </form>
    </div>

    <!-- Toggler on right -->
    <button
      class="navbar-toggler ms-auto"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNav"
    >
      <span class="navbar-toggler-icon"></span>
    </button>
  </div>

  <!-- Nav links -->
  <div class="collapse navbar-collapse justify-content-end px-3" id="navbarNav">
    <ul class="navbar-nav ms-auto">
      <li class="nav-item">
        <a class="nav-link" href="/listings/new">Create New Listing</a>
      </li>
      <% if (!currentUser) { %>
      <li class="nav-item">
        <a class="nav-link" href="/signup"><b>Sign up</b></a>
      </li>
      <li class="nav-item">
        <a class="nav-link" href="/login"><b>Log in</b></a>
      </li>
      <% } else { %>
      <li class="nav-item">
        <a class="nav-link" href="/logout"><b>Logout</b></a>
      </li>
      <% } %>
    </ul>
  </div>
</nav>
