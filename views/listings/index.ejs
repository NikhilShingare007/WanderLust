<% layout("/layouts/boilerplate") %>

<main class="flex-grow-1">
  <div class="index-filters">
    <div id="filters">
      <div class="scroll-hint d-md-none text-end mt-1">
        <small>scroll →</small>
      </div>

      <a
        href="/listings"
        class="filter <%= selectedCategory === 'all' ? 'active' : '' %>"
      >
        <i class="fa-solid fa-globe"></i>
        <p>All</p>
      </a>

      <a
        href="/listings?category=trending"
        class="filter <%= selectedCategory === 'trending' ? 'active' : '' %>"
      >
        <i class="fa-solid fa-fire"></i>
        <p>Trending</p>
      </a>

      <a
        href="/listings?category=beach"
        class="filter <%= selectedCategory === 'beach' ? 'active' : '' %>"
      >
        <i class="fa-solid fa-volleyball"></i>
        <p>Beach</p>
      </a>

      <a
        href="/listings?category=rooms"
        class="filter <%= selectedCategory === 'rooms' ? 'active' : '' %>"
      >
        <i class="fa-solid fa-bed"></i>
        <p>Rooms</p>
      </a>

      <a
        href="/listings?category=iconic cities"
        class="filter <%= selectedCategory === 'iconic cities' ? 'active' : '' %>"
      >
        <i class="fa-solid fa-mountain-city"></i>
        <p>Iconic Cities</p>
      </a>

      <a
        href="/listings?category=mountains"
        class="filter <%= selectedCategory === 'mountains' ? 'active' : '' %>"
      >
        <i class="fa-solid fa-mountain-sun"></i>
        <p>Mountains</p>
      </a>

      <a
        href="/listings?category=castles"
        class="filter <%= selectedCategory === 'castles' ? 'active' : '' %>"
      >
        <i class="fa-brands fa-fort-awesome"></i>
        <p>Castles</p>
      </a>

      <a
        href="/listings?category=amazing pools"
        class="filter <%= selectedCategory === 'amazing pools' ? 'active' : '' %>"
      >
        <i class="fa-solid fa-person-swimming"></i>
        <p>Amazing Pools</p>
      </a>

      <a
        href="/listings?category=camping"
        class="filter <%= selectedCategory === 'camping' ? 'active' : '' %>"
      >
        <i class="fa-solid fa-campground"></i>
        <p>Camping</p>
      </a>

      <a
        href="/listings?category=river"
        class="filter <%= selectedCategory === 'river' ? 'active' : '' %>"
      >
        <i class="fa-solid fa-water"></i>
        <p>River</p>
      </a>

      <a
        href="/listings?category=arctic"
        class="filter <%= selectedCategory === 'arctic' ? 'active' : '' %>"
      >
        <i class="fa-solid fa-snowflake"></i>
        <p>Arctic</p>
      </a>

      <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
          <input
            class="form-check-input"
            type="checkbox"
            role="switch"
            id="switchCheckDefault"
          />
          <label class="form-check-label" for="switchCheckDefault"
            >Display Total after Taxes</label
          >
        </div>
      </div>
    </div>
  </div>

  <% if (hasResults) { %>
  <div class="container-fluid index-cards px-4">
    <div
      class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-4 row-cols-xxl-5 g-4"
    >
      <% for (let listing of allListings) { %>
      <div class="col">
        <a
          href="/listings/<%= listing._id %>"
          class="text-decoration-none text-dark d-block h-100"
        >
          <div class="card h-100 listing-card">
            <img
              src="<%= listing.image.url %>"
              class="card-img-top"
              alt="Listing-image"
              style="height: 20rem; object-fit: cover"
            />
            <div class="card-body">
              <p class="card-text mb-0">
                <strong><%= listing.title %></strong><br />
                &#8377;<%= listing.price.toLocaleString("en-IN") %>/ Night
                <i class="tax-info"> &nbsp; &nbsp; +18% GST</i>
              </p>
            </div>
          </div>
        </a>
      </div>
      <% } %>
    </div>
    <% } else { %>
    <div class="text-center mt-4">
      <div class="alert alert-warning" role="alert">
        No listings found for your search.
      </div>
    </div>
  </div>
  <% } %>
</main>
<script>
  let taxSwitch = document.getElementById("switchCheckDefault");
  taxSwitch.addEventListener("click", () => {
    let taxInfo = document.getElementsByClassName("tax-info");
    for (let tax of taxInfo) {
      if (tax.style.display != "inline") {
        tax.style.display = "inline";
      } else {
        tax.style.display = "none";
      }
    }
  });
</script>
