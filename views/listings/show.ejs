<% layout("/layouts/boilerplate")%> <% if (typeof coords !== "undefined" &&
coords.coordinates[1] && coords.coordinates[1] ) { %>
<script>
  const lat = Number("<%- coords.coordinates[1] %>");
  const lng = Number("<%- coords.coordinates[0] %>");
  const listings = JSON.parse(
    decodeURIComponent("<%- encodeURIComponent(JSON.stringify(listings)) %>")
  );
</script>
<% } %>

<div class="container py-3">
  <div class="row show-all">
    <div class="col-12 col-md-8 offset-md-2">
      <br /><br />
      <h3><strong><%= listings.title %></strong><br /></h3>
      <div class="card listing-card w-100">
        <img
          src="<%= listings.image.url %>"
          class="card-img-top mb-3 img-fluid"
          alt="listing_image"
          style="max-height: 20rem; object-fit: cover"
        />
        <div class="card-body">
          <p class="card-text">
            Owner name -: <b><i><%= listings.owner.username %></i></b>
          </p>
          <p class="card-text"><%= listings.description %></p>
          <p class="card-text">
            ₹<%= listings.price.toLocaleString("en-IN") %>
          </p>
          <p class="card-text"><%= listings.location %></p>
          <p class="card-text"><%= listings.country %></p>
          <% if (currentUser && listings.owner._id.equals(currentUser._id)) { %>
          <div class="btn-show mt-2 d-flex gap-2">
            <a
              href="/listings/<%= listings._id %>/edit"
              class="btn btn-outline-primary"
              >Edit
            </a>
            <form
              method="POST"
              action="/listings/<%= listings._id %>?_method=DELETE"
              onsubmit="return confirm('Do you want to delete this listing?');"
              class="d-inline"
            >
              <button class="btn btn-outline-dark">Delete</button>
            </form>
          </div>
          <% } %>
        </div>
      </div>
    </div>

    <div class="col-12 col-md-8 offset-md-2 mt-4">
      <hr />
      <h4>Leave a Review</h4>
      <% if(currentUser) { %>
      <form
        method="POST"
        action="/listings/<%= listings._id %>/reviews"
        class="needs-validation"
        novalidate
      >
        <div class="mb-3">
          <label for="rating" class="form-label">Rating</label>
          <fieldset class="starability-slot">
            <input
              type="radio"
              name="review[rating]"
              id="no-rate"
              class="visually-hidden"
              value=""
              checked
            />

            <% for (let i = 1; i <= 5; i++) { %>
            <input
              type="radio"
              id="first-rate<%= i %>"
              name="review[rating]"
              value="<%= i %>"
            />
            <label
              for="first-rate<%= i %>"
              title="<%= ['Terrible','Not good','Average','Very good','Amazing'][i - 1] %>"
            >
              <%= i %> star<%= i > 1 ? 's' : '' %>
            </label>
            <% } %>
          </fieldset>
        </div>

        <div class="mb-3">
          <label for="comment" class="form-label">Comment</label>
          <textarea
            rows="4"
            id="review"
            name="review[comment]"
            class="form-control"
            required
          ></textarea>
          <div class="invalid-feedback">Please add a comment.</div>
        </div>
        <button class="btn btn-outline-dark">Submit</button>
      </form>
      <% } else { %>
      <p>You need to log in to write a review.</p>
      <% } %>
    </div>

    <div class="col-12 col-md-8 offset-md-2 mt-4">
      <hr />
      <h4>All Reviews</h4>
      <% if(listings.reviews && listings.reviews.length > 0) { %>
      <div class="row">
        <% for(let review of listings.reviews) { %>
        <div class="card col-11 col-md-5 m-3">
          <div class="card-body">
            <div class="card-title"><b>@<%= review.author.username %></b></div>
            <p
              class="starability-result card-text"
              data-rating="<%= review.rating %>"
            ></p>
            <div class="card-text"><%= review.comment %></div>
          </div>
          <% if (currentUser && review.author._id.equals(currentUser._id)) { %>
          <form
            method="post"
            action="/listings/<%= listings._id %>/reviews/<%= review._id %>?_method=DELETE"
            onsubmit="return confirm('Do you want to delete this review?')"
          >
            <button class="btn btn-sm btn-dark mb-2 ms-2">Delete</button>
          </form>
          <% } %>
        </div>
        <% } %>
      </div>
      <% } else { %>
      <p class="text-muted">No reviews yet. Be the first to leave a review!</p>
      <% } %>
    </div>

    <div class="col-12 col-md-8 offset-md-2 mt-4 mb-5">
      <hr />
      <h4>Where you'll be</h4>
      <% if (typeof coords !== "undefined" && coords.coordinates[1] &&
      coords.coordinates[1] ) { %>
      <div id="map" style="width: 100%; height: 400px"></div>
      <script src="/js/map.js"></script>
      <script
        async
        src="https://maps.googleapis.com/maps/api/js?key=<%= process.env.MAP_API %>&callback=initMap"
      ></script>
      <% } else { %>
      <p>We can't show the map now!</p>
      <% } %>
    </div>
  </div>
</div>
